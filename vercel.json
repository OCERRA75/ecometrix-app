{
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/internal?route=send-monthly-reminder",
      "schedule": "0 14 1 * *"
    },
    {
      "path": "/api/internal?route=keep-alive",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/internal?route=process-ia-queue",
      "schedule": "0 13 * * *"
    }
  ]
}
